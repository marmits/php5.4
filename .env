# --- Chemins hôte -> conteneurs ---
APP_DIR=./app
PROJET1_HOST=/home/debian/devweb/php5/projet1
PROJET2_HOST=/home/debian/devweb/php5/projet2

# --- Réseau / ports ---
APACHE_PORT=8004

# --- PHP / Environnement ---
TIMEZONE=Europe/Paris
NEW_UID=1000
NEW_GID=1000
ENABLE_MODULES=mysql,mysqli,pdo_mysql,mcrypt,gd,intl,soap,zip

# --- Image PHP (optionnel : rend la version paramétrable) ---
PHP_IMAGE=devilbox/php-fpm
PHP_TAG=5.4-prod

# --- Noms des conteneurs (optionnel) ---
FPM_CONTAINER_NAME=fpm-php54-php
APACHE_CONTAINER_NAME=fpm-php54-apache

NEW_UID=1000
NEW_GID=1000

# --- MariaDB ---

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
MARIADB_ROOT_PASSWORD=
MARIADB_PORT=   # décommente si tu publies le port

# --- Nom du projet (optionnel, utilisé par Docker pour préfixer réseaux/volumes) ---
# COMPOSE_PROJECT_NAME=php54stack

